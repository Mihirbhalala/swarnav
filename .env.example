# Swarnav Tour & Travels - Email & Environment Configuration
# Copy this file to .env in the same folder and update your values.

# Admin email where new inquiry notifications will be sent
ADMIN_NOTIFICATION_EMAIL=admin@swarnavtravels.com

# Email Sending (SMTP) Configuration (e.g. Gmail, Zoho, Hostinger, Outlook, or cPanel)
# For Gmail, use your email and a 16-character App Password (from Google Account > Security > 2-Step Verification > App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Default sender email displayed on sent messages
DEFAULT_FROM_EMAIL=Swarnav Tour & Travels <your_email@gmail.com>

# Google Gemini API Key for AI Yatra Assistant (RAG & Agent)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
